# pwr-tracker configuration. Copy to .env and adjust. All values shown are defaults.
# Durations use Go syntax: 30s, 5m, 2160h.

# --- Server ---
LISTEN_ADDR=:8080
# SQLite database file. Keep it on a local disk or Docker volume (not NFS/SMB).
DATABASE_PATH=/data/pwr-tracker.db
# debug | info | warn | error (JSON logs on stdout)
LOG_LEVEL=info

# --- Upstream polling ---
UPSTREAM_URL=https://powerhitradio.tv3.lt/Pwr/lastSong/
# Timezone of the upstream "date" field (station local time).
UPSTREAM_TIMEZONE=Europe/Vilnius
# Empty = "pwr-tracker/<version> (+https://github.com/aurimasniekis/go-pwr-tracker)"
USER_AGENT=
POLL_INTERVAL=60s
# Delay before the first poll after startup.
STARTUP_DELAY=2s
HTTP_TIMEOUT=15s
# Upper bound for exponential backoff after failures (>= POLL_INTERVAL).
MAX_BACKOFF=15m
# Maximum accepted upstream body size in bytes.
MAX_RESPONSE_BYTES=65536
# Now-playing is reported stale when the last success is older than this.
# Empty/0 = 3 × POLL_INTERVAL.
STALE_AFTER=
# Without an upstream event id, observations further apart than this start a
# new (uncertain) play. Empty/0 = 5 × POLL_INTERVAL.
CONTINUITY_GAP=
# Set to false to serve existing data without polling.
COLLECTOR_ENABLED=true

# --- Fetch transport ---
# direct (default) or flaresolverr. There is no automatic fallback.
FETCH_MODE=direct
# Required when FETCH_MODE=flaresolverr, e.g. http://flaresolverr:8191 in Compose.
FLARESOLVERR_URL=
# Passed to FlareSolverr as maxTimeout.
FLARESOLVERR_TIMEOUT=60s

# --- Analytics / display ---
# IANA timezone for day/hour buckets and default display.
ANALYTICS_TIMEZONE=Europe/Vilnius

# --- Retention ---
# Observations (one row per successful poll) older than this are deleted.
# Plays are kept forever. 0 keeps observations forever.
OBSERVATION_RETENTION=2160h
# Store raw upstream bodies with each observation (debugging aid).
STORE_RAW_PAYLOADS=false
# Raw bodies older than this are cleared (the observation row is kept).
RAW_PAYLOAD_RETENTION=168h

# --- Compose only ---
# Host port for the app.
PWR_PORT=8080
